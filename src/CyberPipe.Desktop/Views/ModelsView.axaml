<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CyberPipe.Desktop.ViewModels"
             xmlns:contracts="using:CyberPipe.Contracts"
             x:Class="CyberPipe.Desktop.Views.ModelsView">

  <ScrollViewer Margin="16">
    <StackPanel Spacing="16" MaxWidth="850" HorizontalAlignment="Left">
      <!-- Header Banner / Installer Entry Point -->
      <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
              CornerRadius="8"
              Padding="16">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Grid.Column="0" Spacing="4">
            <TextBlock Text="Model Catalogs &amp; Tier Assignments" FontWeight="Bold" FontSize="18" />
            <TextBlock Text="{Binding InstallerNotice}" TextWrapping="Wrap" FontSize="12" Opacity="0.8" />
          </StackPanel>
          <Button Grid.Column="1"
                  Content="Обновить состояние"
                  Command="{Binding LaunchInstallerCommand}"
                  Classes="accent"
                  VerticalAlignment="Center"
                  Margin="16,0,0,0" />
        </Grid>
      </Border>

      <!-- Tier Model Assignments Configuration (Editable) -->
      <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
              CornerRadius="8"
              Padding="16">
        <StackPanel Spacing="12">
          <Grid ColumnDefinitions="*,Auto,Auto">
            <StackPanel Grid.Column="0" Spacing="2">
              <TextBlock Text="Назначение моделей по ярусам (Tier Model Assignments)" FontWeight="Bold" FontSize="16" />
              <TextBlock Text="Выберите модели для обработки запросов. Изменения сохраняются в ui-overrides.json и вступают в силу немедленно." FontSize="11" Opacity="0.7" />
            </StackPanel>

            <Button Grid.Column="1"
                    Content="По умолчанию"
                    Command="{Binding ResetTierAssignmentsCommand}"
                    Margin="8,0"
                    VerticalAlignment="Center" />

            <Button Grid.Column="2"
                    Content="Сохранить назначения"
                    Command="{Binding SaveTierAssignmentsCommand}"
                    Classes="accent"
                    VerticalAlignment="Center" />
          </Grid>

          <!-- Status / confirmation message -->
          <Border Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                  Padding="8,6"
                  CornerRadius="4"
                  IsVisible="{Binding HasStatusMessage}">
            <TextBlock Text="{Binding StatusMessage}"
                       FontWeight="SemiBold"
                       FontSize="12"
                       Foreground="{DynamicResource SystemAccentColor}" />
          </Border>

          <!-- Assignments list -->
          <ItemsControl ItemsSource="{Binding Assignments}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="vm:TierModelAssignmentViewModel">
                <Border Margin="0,4"
                        Padding="12"
                        CornerRadius="6"
                        Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
                  <Grid ColumnDefinitions="190,*,Auto" VerticalAlignment="Center">
                    <!-- Left: Tier title and description -->
                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center" Margin="0,0,12,0">
                      <TextBlock Text="{Binding TierName}" FontWeight="SemiBold" FontSize="13" />
                      <TextBlock Text="{Binding Description}" FontSize="11" Opacity="0.7" TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- Middle: Selector / Editor -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                      <!-- For editable tiers: Dropdown + Textbox -->
                      <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding IsEditable}">
                        <ComboBox Grid.Column="0"
                                  ItemsSource="{Binding AvailableModels}"
                                  SelectedItem="{Binding SelectedModel}"
                                  MinWidth="220"
                                  Margin="0,0,8,0"
                                  VerticalAlignment="Center" />
                        <TextBox Grid.Column="1"
                                 Text="{Binding ModelId}"
                                 PlaceholderText="ID модели"
                                 FontFamily="Consolas,Menlo,monospace"
                                 VerticalAlignment="Center" />
                      </Grid>

                      <!-- For non-editable tier (Tier 0): Static text -->
                      <TextBlock Text="{Binding ModelId}"
                                 FontFamily="Consolas,Menlo,monospace"
                                 FontWeight="SemiBold"
                                 VerticalAlignment="Center"
                                 IsVisible="{Binding !IsEditable}" />
                    </StackPanel>

                    <!-- Right: Hosting Type switcher (Tier 2/3) or static badge (Tier 0/1) -->
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                      <!-- Interactive toggle switch for Tier 2 and Tier 3: Local <-> Remote Cloud -->
                      <ToggleSwitch IsChecked="{Binding IsRemoteHosting}"
                                    OnContent="Удаленный"
                                    OffContent="Локальный"
                                    IsVisible="{Binding HasHostingSelector}"
                                    VerticalAlignment="Center" />

                      <!-- Static badge for fixed hosting tiers (Tier 0 & Tier 1) -->
                      <Border Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                              CornerRadius="4"
                              Padding="8,4"
                              VerticalAlignment="Center"
                              IsVisible="{Binding !HasHostingSelector}">
                        <TextBlock Text="{Binding HostingTypeText}" FontSize="11" FontWeight="SemiBold" Opacity="0.8" />
                      </Border>

                      <!-- Test Model Button -->
                      <Button Content="💬 Тест"
                              Command="{Binding TestCommand}"
                              Padding="8,4"
                              Margin="4,0,0,0"
                              ToolTip.Tip="Открыть диалог проверки прямого ответа модели"
                              VerticalAlignment="Center" />
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!-- Ollama Runtime Status & Actions -->
      <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
              CornerRadius="8"
              Padding="16"
              IsVisible="{Binding HasInstaller}">
        <StackPanel Spacing="8">
          <TextBlock Text="Локальный рантайм (Ollama)" FontWeight="Bold" FontSize="16" />
          <Grid ColumnDefinitions="*,Auto,Auto">
            <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
              <TextBlock Text="{Binding Installer.RuntimeStatusText}" FontSize="13" />
            </StackPanel>
            <Button Grid.Column="1"
                    Content="Установить Ollama"
                    Command="{Binding Installer.EnsureRuntimeCommand}"
                    Classes="accent"
                    Margin="8,0" />
            <Button Grid.Column="2"
                    Content="Обновить статус"
                    Command="{Binding Installer.RefreshCommand}" />
          </Grid>
        </StackPanel>
      </Border>

      <!-- Tier 1 Semantic Embedding (multilingual-e5-small) -->
      <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
              CornerRadius="8"
              Padding="16"
              IsVisible="{Binding HasInstaller}">
        <StackPanel Spacing="10">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
              <TextBlock Text="Tier 1 — Семантический эмбеддинг (multilingual-e5-small ONNX)" FontWeight="Bold" FontSize="16" />
              <TextBlock Text="Локальная ONNX-модель для семантической маршрутизации и кэша." FontSize="11" Opacity="0.7" />
              <TextBlock Text="{Binding Installer.EmbeddingStateText}" FontSize="13" FontWeight="SemiBold" Margin="0,2,0,0" />
            </StackPanel>

            <!-- Action buttons -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <!-- Download button -->
              <Button Content="Скачать и подключить эмбеддинг"
                      Command="{Binding Installer.EnsureEmbeddingCommand}"
                      IsVisible="{Binding !Installer.IsEmbeddingInstalled}"
                      IsEnabled="{Binding !Installer.IsEmbeddingDownloading}"
                      Classes="accent" />

              <!-- Cancel button during download -->
              <Button Content="Отмена"
                      Command="{Binding Installer.CancelEmbeddingCommand}"
                      IsVisible="{Binding Installer.IsEmbeddingDownloading}" />

              <!-- Remove from disk button -->
              <Button Content="Удалить с диска"
                      Command="{Binding Installer.RequestRemoveEmbeddingCommand}"
                      IsVisible="{Binding Installer.IsEmbeddingInstalled}"
                      IsEnabled="{Binding !Installer.IsEmbeddingDownloading}" />
            </StackPanel>
          </Grid>

          <!-- Download Progress Bar & Text -->
          <StackPanel Spacing="4" IsVisible="{Binding Installer.IsEmbeddingDownloading}">
            <ProgressBar Minimum="0" Maximum="100"
                         Value="{Binding Installer.EmbeddingProgressPercent}"
                         Height="6" />
            <TextBlock Text="{Binding Installer.EmbeddingProgressText}"
                       FontSize="11"
                       Opacity="0.85"
                       FontFamily="Consolas,Menlo,monospace" />
          </StackPanel>

          <!-- Confirmation prompt for removing from disk -->
          <Border Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                  CornerRadius="6"
                  Padding="12"
                  Margin="0,4,0,0"
                  IsVisible="{Binding Installer.EmbeddingNeedsRemoveConfirmation}">
            <Grid ColumnDefinitions="*,Auto,Auto">
              <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                <TextBlock Text="Удалить файлы модели multilingual-e5-small с диска?"
                           FontWeight="SemiBold"
                           FontSize="13"
                           Foreground="{DynamicResource SystemAccentColor}" />
                <TextBlock Text="Файлы модели будут удалены из локального хранилища. Для работы Tier 1 потребуется повторное скачивание."
                           FontSize="11"
                           Opacity="0.8" />
              </StackPanel>

              <Button Grid.Column="1"
                      Content="Да, удалить"
                      Command="{Binding Installer.ConfirmRemoveEmbeddingCommand}"
                      Classes="accent"
                      Margin="8,0"
                      VerticalAlignment="Center" />

              <Button Grid.Column="2"
                      Content="Отмена"
                      Command="{Binding Installer.CancelRemoveEmbeddingCommand}"
                      VerticalAlignment="Center" />
            </Grid>
          </Border>
        </StackPanel>
      </Border>

      <!-- Local AI Models Installer List -->
      <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
              CornerRadius="8"
              Padding="16"
              IsVisible="{Binding HasInstaller}">
        <StackPanel Spacing="12">
          <TextBlock Text="Локальные ИИ модели (Ollama)" FontWeight="Bold" FontSize="16" />

          <ItemsControl ItemsSource="{Binding Installer.Items}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="vm:LocalModelItemViewModel">
                <Border Margin="0,4"
                        Padding="12"
                        CornerRadius="6"
                        Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
                  <StackPanel Spacing="6">
                    <Grid ColumnDefinitions="*,Auto,Auto">
                      <StackPanel Grid.Column="0" Spacing="2">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <TextBlock Text="{Binding Model.Name}" FontWeight="SemiBold" FontSize="14" />
                          <TextBlock Text="{Binding GroupTitle}" FontSize="11" Opacity="0.7" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                          <TextBlock Text="{Binding Model.ModelId}" FontFamily="Consolas,Menlo,monospace" FontSize="12" Opacity="0.8" />
                          <TextBlock Text="{Binding Model.Q4SizeGb, StringFormat='Размер: {0:F1} ГБ'}" FontSize="11" Opacity="0.7" />
                          <TextBlock Text="{Binding VerdictText}" FontSize="11" FontWeight="SemiBold" />
                        </StackPanel>
                      </StackPanel>

                      <!-- Status Badge -->
                      <TextBlock Grid.Column="1" Text="{Binding State}" Margin="12,0" VerticalAlignment="Center" FontWeight="SemiBold" />

                      <!-- Action Buttons -->
                      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                        <Button Content="Установить"
                                Command="{Binding InstallCommand}"
                                IsVisible="{Binding CanInstall}"
                                Classes="accent" />
                        <Button Content="💬 Тест"
                                Command="{Binding TestCommand}"
                                IsVisible="{Binding IsInstalled}"
                                ToolTip.Tip="Открыть диалог проверки прямого ответа модели" />
                        <Button Content="Проверить"
                                Command="{Binding VerifyCommand}"
                                IsVisible="{Binding IsInstalled}" />
                        <Button Content="Удалить"
                                Command="{Binding RemoveCommand}"
                                IsVisible="{Binding IsInstalled}" />
                        <Button Content="Назначить на Tier"
                                Command="{Binding AssignCommand}"
                                IsVisible="{Binding IsInstalled}" />
                        <Button Content="Отмена"
                                Command="{Binding CancelCommand}"
                                IsVisible="{Binding IsDownloading}" />
                      </StackPanel>
                    </Grid>

                    <!-- Progress Bar during download -->
                    <ProgressBar Value="{Binding ProgressPercent}"
                                 Minimum="0" Maximum="100"
                                 Height="4"
                                 IsVisible="{Binding IsDownloading}" />

                    <!-- Status or progress message -->
                    <TextBlock Text="{Binding ProgressText}"
                               FontSize="11" Opacity="0.8"
                               IsVisible="{Binding IsDownloading}" />

                    <TextBlock Text="{Binding StatusMessage}"
                               FontSize="11" Opacity="0.8" />

                    <!-- Risk confirmation prompt -->
                    <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding NeedsRiskConfirmation}">
                      <TextBlock Text="Мало RAM/VRAM для этой модели! Возможны фризы системы."
                                 FontSize="11" Foreground="Red" VerticalAlignment="Center" />
                      <Button Content="Всё равно установить"
                              Command="{Binding ConfirmRiskCommand}"
                              Classes="accent" />
                    </StackPanel>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!-- Catalog Overview -->
      <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
              CornerRadius="8"
              Padding="16">
        <StackPanel Spacing="12">
          <TextBlock Text="Model Catalog" FontWeight="Bold" FontSize="16" />

          <ItemsControl ItemsSource="{Binding CatalogItems}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="vm:CatalogItemViewModel">
                <Border Margin="0,4"
                        Padding="10"
                        CornerRadius="6"
                        Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
                  <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto">
                    <StackPanel Grid.Column="0" Spacing="2">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding ParamsSummary}" FontSize="11" Opacity="0.7" />
                      <TextBlock Text="{Binding BestFor}" FontSize="11" Opacity="0.7" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding HostingType}" Margin="12,0" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{Binding Provider}" Opacity="0.6" Margin="0,0,12,0" VerticalAlignment="Center" />
                    <Button Grid.Column="3"
                            Content="Назначить"
                            Command="{Binding AssignCommand}"
                            VerticalAlignment="Center" />
                    <Button Grid.Column="4"
                            Content="💬 Тест"
                            Command="{Binding TestCommand}"
                            Margin="8,0,0,0"
                            ToolTip.Tip="Открыть диалог проверки прямого ответа модели"
                            VerticalAlignment="Center" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
