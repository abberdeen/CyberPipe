<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CyberPipe.Desktop.ViewModels"
             x:Class="CyberPipe.Desktop.Views.ModelsView">

  <ScrollViewer Margin="16">
    <StackPanel Spacing="16" MaxWidth="980" HorizontalAlignment="Stretch">
      <StackPanel Spacing="4">
        <TextBlock Text="Настройка ИИ-моделей" FontWeight="Bold" FontSize="22" />
        <TextBlock Text="{Binding HardwareSummaryText}" FontSize="13" Opacity="0.8" TextWrapping="Wrap" />
      </StackPanel>

      <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
        <Border Grid.Column="0"
                Padding="16"
                CornerRadius="8"
                Background="{DynamicResource SystemControlBackgroundAltHighBrush}">
          <StackPanel Spacing="8">
            <TextBlock Text="🏠 Локальные модели (На вашем ПК • 0$)" FontWeight="Bold" FontSize="16" TextWrapping="Wrap" />
            <TextBlock Text="{Binding OllamaSummaryText}" FontSize="13" TextWrapping="Wrap" />
            <Button Content="🦙 Управление моделями Ollama"
                    Command="{Binding OpenOllamaManagerCommand}"
                    Classes="accent"
                    HorizontalAlignment="Left" />
            <TextBlock Text="Движки: [✓ Ollama]  [⏳ LM Studio — в будущих версиях]"
                       FontSize="12"
                       Opacity="0.7"
                       TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <Border Grid.Column="1"
                Padding="16"
                CornerRadius="8"
                Background="{DynamicResource SystemControlBackgroundAltHighBrush}">
          <StackPanel Spacing="8">
            <TextBlock Text="☁️ Облачные провайдеры (По API-ключу)" FontWeight="Bold" FontSize="16" TextWrapping="Wrap" />
            <TextBlock Text="{Binding RemoteProvidersSummaryText}" FontSize="13" TextWrapping="Wrap" />
            <Button Content="🔑 Настроить провайдеры и API-ключи"
                    Command="{Binding OpenRemoteProvidersCommand}"
                    Classes="accent"
                    HorizontalAlignment="Left" />
          </StackPanel>
        </Border>
      </Grid>

      <Border Padding="16" CornerRadius="8" Background="{DynamicResource SystemControlBackgroundAltHighBrush}">
        <StackPanel Spacing="12">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="2">
              <TextBlock Text="Какие модели сейчас отвечают на ваши запросы" FontWeight="Bold" FontSize="16" />
              <TextBlock Text="Выбор сохраняется сразу. Сложный список ярусов спрятан: остаются только две рабочие роли."
                         FontSize="12"
                         Opacity="0.7"
                         TextWrapping="Wrap" />
            </StackPanel>
            <Button Grid.Column="1"
                    Content="Сбросить по умолчанию"
                    Command="{Binding ResetTierAssignmentsCommand}"
                    VerticalAlignment="Center" />
          </Grid>

          <Border Padding="12" CornerRadius="6" Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                  IsVisible="{Binding HasStatusMessage}">
            <TextBlock Text="{Binding StatusMessage}" FontSize="12" TextWrapping="Wrap" />
          </Border>

          <Border Padding="14" CornerRadius="8" Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
              <StackPanel Spacing="8">
                <TextBlock Text="{Binding FastAssistantAssignment.RoleTitle}" FontWeight="SemiBold" FontSize="16" />
                <TextBlock Text="{Binding FastAssistantAssignment.RoleSubtitle}" FontSize="12" Opacity="0.75" TextWrapping="Wrap" />
                <ToggleSwitch IsChecked="{Binding FastAssistantAssignment.IsRemoteHosting}"
                              OffContent="🏠 На моём ПК (Бесплатно)"
                              OnContent="☁️ В облаке (API)" />
                <ComboBox ItemsSource="{Binding FastAssistantAssignment.AvailableModels}"
                          SelectedItem="{Binding FastAssistantAssignment.SelectedModel}"
                          MinWidth="280"
                          HorizontalAlignment="Left" />
                <TextBlock Text="{Binding FastAssistantAssignment.SelectionHint}" FontSize="12" Opacity="0.75" TextWrapping="Wrap" />
                <Button Content="📥 Скачать модели в менеджере Ollama"
                        Command="{Binding OpenOllamaManagerCommand}"
                        HorizontalAlignment="Left"
                        IsVisible="{Binding ShowFastLocalDownloadHint}" />
              </StackPanel>
              <Button Grid.Column="1"
                      Content="💬 Проверить"
                      Command="{Binding FastAssistantAssignment.TestCommand}"
                      VerticalAlignment="Center" />
            </Grid>
          </Border>

          <Border Padding="14" CornerRadius="8" Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
              <StackPanel Spacing="8">
                <TextBlock Text="{Binding SmartExpertAssignment.RoleTitle}" FontWeight="SemiBold" FontSize="16" />
                <TextBlock Text="{Binding SmartExpertAssignment.RoleSubtitle}" FontSize="12" Opacity="0.75" TextWrapping="Wrap" />
                <ToggleSwitch IsChecked="{Binding SmartExpertAssignment.IsRemoteHosting}"
                              OffContent="🏠 На моём ПК (Бесплатно)"
                              OnContent="☁️ В облаке (API)" />
                <ComboBox ItemsSource="{Binding SmartExpertAssignment.AvailableModels}"
                          SelectedItem="{Binding SmartExpertAssignment.SelectedModel}"
                          MinWidth="280"
                          HorizontalAlignment="Left" />
                <TextBlock Text="{Binding SmartExpertAssignment.SelectionHint}" FontSize="12" Opacity="0.75" TextWrapping="Wrap" />
                <Button Content="📥 Скачать модели в менеджере Ollama"
                        Command="{Binding OpenOllamaManagerCommand}"
                        HorizontalAlignment="Left"
                        IsVisible="{Binding ShowExpertLocalDownloadHint}" />
              </StackPanel>
              <Button Grid.Column="1"
                      Content="💬 Проверить"
                      Command="{Binding SmartExpertAssignment.TestCommand}"
                      VerticalAlignment="Center" />
            </Grid>
          </Border>
        </StackPanel>
      </Border>

      <Border Padding="14"
              CornerRadius="8"
              Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
              IsVisible="{Binding HasInstaller}">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
          <StackPanel Spacing="4">
            <TextBlock Text="🔍 Системный модуль умного поиска и памяти (Tier 1 ONNX)" FontWeight="SemiBold" />
            <TextBlock Text="Отвечает за мгновенный поиск по вашим заметкам и понимание смысла команд без расхода токенов (multilingual-e5-small)."
                       FontSize="12"
                       Opacity="0.75"
                       TextWrapping="Wrap" />
            <TextBlock Text="{Binding Installer.EmbeddingStateText}" FontSize="12" />
            <ProgressBar Minimum="0"
                         Maximum="100"
                         Height="6"
                         Value="{Binding Installer.EmbeddingProgressPercent}"
                         IsVisible="{Binding Installer.IsEmbeddingDownloading}" />
          </StackPanel>
          <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
            <Button Content="📥 Скачать (470 МБ)"
                    Command="{Binding Installer.EnsureEmbeddingCommand}"
                    Classes="accent"
                    IsVisible="{Binding Installer.CanDownloadEmbedding}" />
            <Button Content="Отмена"
                    Command="{Binding Installer.CancelEmbeddingCommand}"
                    IsVisible="{Binding Installer.IsEmbeddingDownloading}" />
            <Button Content="Удалить с диска"
                    Command="{Binding Installer.RequestRemoveEmbeddingCommand}"
                    IsVisible="{Binding Installer.IsEmbeddingInstalled}" />
            <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding Installer.EmbeddingNeedsRemoveConfirmation}">
              <Button Content="Да, удалить" Command="{Binding Installer.ConfirmRemoveEmbeddingCommand}" />
              <Button Content="Отмена" Command="{Binding Installer.CancelRemoveEmbeddingCommand}" />
            </StackPanel>
          </StackPanel>
        </Grid>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
