<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CyberPipe.Desktop.ViewModels"
        x:Class="CyberPipe.Desktop.Views.OllamaManagerWindow"
        x:DataType="vm:OllamaManagerViewModel"
        Title="Управление локальными моделями — Ollama"
        Width="920"
        Height="680"
        MinWidth="760"
        MinHeight="520"
        WindowStartupLocation="CenterOwner">

  <Grid Margin="16" RowDefinitions="Auto,Auto,*,Auto">
    <Border Grid.Row="0"
            Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="14"
            Margin="0,0,0,10">
      <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
        <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4">
          <TextBlock Text="{Binding RuntimeStatusText}" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap" />
          <TextBlock Text="{Binding ApiBaseUrl}" FontFamily="Consolas,Menlo,monospace" FontSize="12" Opacity="0.75" />
          <TextBlock Text="{Binding HardwareSummaryText}" FontSize="12" Opacity="0.85" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button Content="🔄 Обновить" Command="{Binding RefreshCommand}" />
          <Button Content="📥 Установить / Проверить Ollama"
                  Command="{Binding EnsureRuntimeCommand}"
                  Classes="accent" />
        </StackPanel>
        <TextBlock Grid.Row="1"
                   Grid.Column="0"
                   Grid.ColumnSpan="2"
                   Margin="0,8,0,0"
                   Text="{Binding MemoryStatusText}"
                   FontSize="12"
                   Opacity="0.8" />
      </Grid>
    </Border>

    <Border Grid.Row="1"
            Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
            CornerRadius="8"
            Padding="12"
            Margin="0,0,0,10"
            IsVisible="{Binding HasRunningModels}">
      <StackPanel Spacing="8">
        <TextBlock Text="Модели в памяти RAM/VRAM" FontWeight="SemiBold" />
        <ItemsControl ItemsSource="{Binding RunningModels}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:RunningOllamaModelItemViewModel">
              <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,2">
                <TextBlock Grid.Column="0" Text="{Binding ModelId}" VerticalAlignment="Center" FontWeight="SemiBold" />
                <TextBlock Grid.Column="1" Text="{Binding SizeFormatted}" VerticalAlignment="Center" Margin="12,0" Opacity="0.8" />
                <Button Grid.Column="2" Content="⏏ Выгрузить из памяти" Command="{Binding UnloadCommand}" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>

    <TabControl Grid.Row="2" SelectedIndex="{Binding SelectedTabIndex}">
      <TabItem Header="{Binding InstalledTabHeader}">
        <Grid RowDefinitions="*,Auto" Margin="0,8,0,0">
          <ScrollViewer Grid.Row="0">
            <ItemsControl ItemsSource="{Binding InstalledModels}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:InstalledOllamaModelItemViewModel">
                  <Border Margin="0,0,0,8"
                          Padding="12"
                          CornerRadius="6"
                          Background="{DynamicResource SystemControlBackgroundAltHighBrush}">
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
                      <StackPanel Grid.Row="0" Grid.Column="0" Spacing="2">
                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="14" />
                        <TextBlock Text="{Binding ModelId}" FontFamily="Consolas,Menlo,monospace" FontSize="12" Opacity="0.7" />
                        <TextBlock Text="{Binding MetaText}" FontSize="12" Opacity="0.8" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Description}" FontSize="12" Opacity="0.75" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding VerdictText}" FontSize="12" />
                      </StackPanel>
                      <WrapPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,8,0,0" Orientation="Horizontal">
                        <Button Content="⚡ Назначить Быстрым" Command="{Binding AssignToFastAssistantCommand}" Margin="0,0,6,6" />
                        <Button Content="🧠 Назначить Экспертом" Command="{Binding AssignToSmartExpertCommand}" Margin="0,0,6,6" />
                        <Button Content="💬 Тест" Command="{Binding TestCommand}" Margin="0,0,6,6" />
                        <Button Content="Проверить" Command="{Binding VerifyCommand}" Margin="0,0,6,6" />
                        <Button Content="🗑 Удалить" Command="{Binding RemoveCommand}" Margin="0,0,6,6" />
                      </WrapPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          <StackPanel Grid.Row="1" Spacing="8" IsVisible="{Binding !HasInstalledModels}" Margin="0,12,0,0">
            <TextBlock Text="В Ollama пока нет установленных моделей. Откройте рекомендации и скачайте подходящую под ваш ПК."
                       TextWrapping="Wrap" Opacity="0.8" />
            <Button Content="Открыть рекомендованные" Command="{Binding GoToRecommendedCommand}" HorizontalAlignment="Left" />
          </StackPanel>
        </Grid>
      </TabItem>

      <TabItem Header="🌟 Рекомендованные для вашего ПК">
        <Grid RowDefinitions="Auto,*" Margin="0,8,0,0">
          <StackPanel Grid.Row="0" Spacing="8" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Button Content="Все" Command="{Binding SetFilterCommand}" CommandParameter="all" />
              <Button Content="Идеально для моего ПК" Command="{Binding SetFilterCommand}" CommandParameter="optimal" />
              <Button Content="Быстрые (Tier 2)" Command="{Binding SetFilterCommand}" CommandParameter="tier2" />
              <Button Content="Умные и для кода (Tier 3)" Command="{Binding SetFilterCommand}" CommandParameter="tier3" />
            </StackPanel>
            <TextBox Text="{Binding SearchQuery}" PlaceholderText="Быстрый поиск по названию или задаче" />
          </StackPanel>
          <ScrollViewer Grid.Row="1">
            <ItemsControl ItemsSource="{Binding FilteredRecommendedModels}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:RecommendedOllamaModelItemViewModel">
                  <Border Margin="0,0,0,8"
                          Padding="12"
                          CornerRadius="6"
                          Background="{DynamicResource SystemControlBackgroundAltHighBrush}">
                    <StackPanel Spacing="6">
                      <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="2">
                          <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="14" />
                          <TextBlock Text="{Binding Model.ModelId}" FontFamily="Consolas,Menlo,monospace" FontSize="12" Opacity="0.7" />
                          <TextBlock Text="{Binding Model.BestFor}" FontSize="12" TextWrapping="Wrap" Opacity="0.8" />
                          <TextBlock Text="{Binding SizeText}" FontSize="12" />
                          <TextBlock Text="{Binding VerdictText}" FontSize="12" />
                          <TextBlock Text="{Binding Explanation}" FontSize="12" Opacity="0.75" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                          <Button Content="📥 Скачать" Command="{Binding InstallCommand}" Classes="accent" IsVisible="{Binding CanInstall}" />
                          <Button Content="✖ Отмена" Command="{Binding CancelCommand}" IsVisible="{Binding IsDownloading}" />
                          <TextBlock Text="Установлена" IsVisible="{Binding IsInstalled}" VerticalAlignment="Center" FontWeight="SemiBold" />
                        </StackPanel>
                      </Grid>
                      <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressPercent}" IsVisible="{Binding IsDownloading}" />
                      <TextBlock Text="{Binding ProgressText}" FontSize="12" IsVisible="{Binding IsDownloading}" />
                      <TextBlock Text="{Binding StatusMessage}" FontSize="12" TextWrapping="Wrap" />
                      <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding NeedsRiskConfirmation}">
                        <TextBlock Text="Модели может не хватить памяти." VerticalAlignment="Center" />
                        <Button Content="Всё равно установить" Command="{Binding ConfirmRiskCommand}" />
                      </StackPanel>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </TabItem>

      <TabItem Header="🔍 Скачать по имени (Pull) &amp; Поиск ONNX">
        <ScrollViewer Margin="0,8,0,0">
          <StackPanel Spacing="12">
            <Border Padding="14"
                    CornerRadius="8"
                    Background="{DynamicResource SystemControlBackgroundAltHighBrush}">
              <StackPanel Spacing="8">
                <TextBlock Text="Скачать любую модель по тегу Ollama" FontWeight="SemiBold" FontSize="14" />
                <TextBlock Text="Например, qwen2.5-coder:7b. Каталог: ollama.com/library" FontSize="12" Opacity="0.75" TextWrapping="Wrap" />
                <TextBox Text="{Binding CustomPullTag}" PlaceholderText="тег модели, например llama3.2:3b" />
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Button Content="qwen2.5-coder:7b" Command="{Binding UsePopularTagCommand}" CommandParameter="qwen2.5-coder:7b" />
                  <Button Content="llama3.2:3b" Command="{Binding UsePopularTagCommand}" CommandParameter="llama3.2:3b" />
                  <Button Content="deepseek-r1:7b" Command="{Binding UsePopularTagCommand}" CommandParameter="deepseek-r1:7b" />
                  <Button Content="nomic-embed-text" Command="{Binding UsePopularTagCommand}" CommandParameter="nomic-embed-text" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Content="📥 Скачать в Ollama" Command="{Binding PullCustomTagCommand}" Classes="accent" />
                  <Button Content="✖ Отмена" Command="{Binding CancelCustomPullCommand}" IsVisible="{Binding IsCustomPulling}" />
                </StackPanel>
                <ProgressBar Minimum="0" Maximum="100" Value="{Binding CustomPullProgressPercent}" IsVisible="{Binding IsCustomPulling}" />
                <TextBlock Text="{Binding CustomPullProgressText}" FontSize="12" />
                <TextBlock Text="{Binding CustomPullStatusMessage}" FontSize="12" TextWrapping="Wrap" />
              </StackPanel>
            </Border>

            <Border Padding="14"
                    CornerRadius="8"
                    Background="{DynamicResource SystemControlBackgroundAltHighBrush}">
              <StackPanel Spacing="8">
                <TextBlock Text="🔍 Системный поиск: multilingual-e5-small (ONNX)" FontWeight="SemiBold" FontSize="14" />
                <TextBlock Text="Мгновенный поиск по заметкам и понимание смысла команд без расхода токенов."
                           FontSize="12" Opacity="0.8" TextWrapping="Wrap" />
                <TextBlock Text="{Binding EmbeddingStateText}" FontSize="12" />
                <ProgressBar Minimum="0" Maximum="100" Value="{Binding EmbeddingProgressPercent}" IsVisible="{Binding IsEmbeddingDownloading}" />
                <TextBlock Text="{Binding EmbeddingProgressText}" FontSize="12" IsVisible="{Binding IsEmbeddingDownloading}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Content="📥 Скачать (470 МБ)" Command="{Binding EnsureEmbeddingCommand}" IsVisible="{Binding CanDownloadEmbedding}" Classes="accent" />
                  <Button Content="Отмена" Command="{Binding CancelEmbeddingCommand}" IsVisible="{Binding IsEmbeddingDownloading}" />
                  <Button Content="Удалить с диска" Command="{Binding RequestRemoveEmbeddingCommand}" IsVisible="{Binding IsEmbeddingInstalled}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding EmbeddingNeedsRemoveConfirmation}">
                  <TextBlock Text="Удалить модуль поиска с диска?" VerticalAlignment="Center" />
                  <Button Content="Да, удалить" Command="{Binding ConfirmRemoveEmbeddingCommand}" />
                  <Button Content="Отмена" Command="{Binding CancelRemoveEmbeddingCommand}" />
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>

    <Button Grid.Row="3"
            Content="Закрыть"
            Command="{Binding CloseCommand}"
            HorizontalAlignment="Right"
            Margin="0,12,0,0" />
  </Grid>
</Window>
