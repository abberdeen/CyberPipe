<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:CyberPipe.Desktop.Views"
        xmlns:vm="using:CyberPipe.Desktop.ViewModels"
        x:Class="CyberPipe.Desktop.Views.TelemetryLogsWindow"
        Title="CyberPipe — Логи OpenTelemetry и процессов (Service, Brainstem, Desktop)"
        Width="1150"
        Height="750"
        MinWidth="800"
        MinHeight="450"
        WindowStartupLocation="CenterScreen">
  <views:TelemetryLogsView DataContext="{Binding}" />
</Window>
