<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CyberPipe.Desktop.ViewModels"
             x:Class="CyberPipe.Desktop.Views.ChatView">

  <Grid RowDefinitions="Auto,*,Auto,Auto" Margin="16">
    <!-- Top Bar: Budget info & Processing status -->
    <Border Grid.Row="0"
            Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
            CornerRadius="8"
            Padding="12"
            Margin="0,0,0,12">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
          <TextBlock Text="Budget:" FontWeight="SemiBold" />
          <TextBlock Text="{Binding BudgetStatus.SpentTodayUsd, StringFormat='Spent: ${0:F2}'}" />
          <TextBlock Text="{Binding BudgetStatus.RemainingTodayUsd, StringFormat='Remaining: ${0:F2}'}" />
          <TextBlock Text="{Binding BudgetStatus.TokensUsedToday, StringFormat='Tokens: {0:N0}'}" />
          <TextBlock Text="{Binding CurrentTier, StringFormat='Tier: {0}'}"
                     Foreground="{DynamicResource SystemAccentColor}"
                     FontWeight="Bold" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
          <Button Content="Refresh Budget" Command="{Binding RefreshBudgetCommand}" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Center: Messages History -->
    <ScrollViewer Grid.Row="1" Margin="0,0,0,12">
      <ItemsControl ItemsSource="{Binding Messages}">
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="vm:ChatMessageViewModel">
            <Border Margin="0,4"
                    Padding="12"
                    CornerRadius="8"
                    HorizontalAlignment="{Binding IsUser, Converter={x:Null}}"
                    MaxWidth="650"
                    Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
              <StackPanel Spacing="4">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{Binding Sender}" FontWeight="Bold" />
                    <TextBlock Text="{Binding TierBadge}"
                               Foreground="{DynamicResource SystemAccentColor}"
                               FontSize="11"
                               VerticalAlignment="Center" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="{Binding FormattedTimestamp}" FontSize="11" Opacity="0.6" VerticalAlignment="Center" />
                    <Button Content="{Binding CopyButtonText}"
                            Command="{Binding CopyCommand}"
                            ToolTip.Tip="{Binding CopyButtonToolTip}"
                            FontSize="11"
                            Padding="8,2"
                            Height="24"
                            VerticalAlignment="Center"
                            Cursor="Hand" />
                  </StackPanel>
                </Grid>
                <SelectableTextBlock Text="{Binding Text}" TextWrapping="Wrap" Margin="0,4,0,0" />
                <TextBlock Text="{Binding AttachmentPath, StringFormat='Attachment: {0}'}"
                           FontSize="11"
                           FontStyle="Italic"
                           IsVisible="{Binding AttachmentPath, Converter={x:Null}}" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <!-- Status message / Progress -->
    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8"
                IsVisible="{Binding StatusMessage, Converter={x:Null}}">
      <ProgressBar IsIndeterminate="True" Width="80" Height="4" IsVisible="{Binding IsProcessing}" />
      <TextBlock Text="{Binding StatusMessage}" FontSize="12" Opacity="0.8" />
    </StackPanel>

    <!-- Bottom: Input area & Abort button -->
    <Grid Grid.Row="3" ColumnDefinitions="*,Auto,Auto,Auto" RowDefinitions="Auto,Auto">
      <TextBox Grid.Row="0" Grid.Column="0"
               x:Name="InputTextBox"
               Text="{Binding InputText, Mode=TwoWay}"
               PlaceholderText="Type a message to the assistant..."
               ToolTip.Tip="Press Enter to send, Shift+Enter for new line"
               AcceptsReturn="True"
               MaxHeight="100"
               KeyDown="OnInputTextBoxKeyDown"
               Margin="0,0,8,0" />

      <TextBox Grid.Row="0" Grid.Column="1"
               Text="{Binding SelectedAttachmentPath, Mode=TwoWay}"
               PlaceholderText="Attachment path..."
               Width="180"
               Margin="0,0,8,0" />

      <Button Grid.Row="0" Grid.Column="2"
              Content="Send"
              Command="{Binding SendCommand}"
              IsDefault="True"
              Classes="accent"
              Margin="0,0,8,0" />

      <Button Grid.Row="0" Grid.Column="3"
              Content="Abort"
              Command="{Binding AbortCommand}"
              Foreground="Red"
              IsEnabled="{Binding IsProcessing}" />
    </Grid>
  </Grid>
</UserControl>
