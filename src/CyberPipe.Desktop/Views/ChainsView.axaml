<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CyberPipe.Desktop.ViewModels"
             x:Class="CyberPipe.Desktop.Views.ChainsView">

  <Grid ColumnDefinitions="320,*" Margin="16">
    <!-- Left Pane: Chains List (Read-only) -->
    <Border Grid.Column="0"
            Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
            CornerRadius="8"
            Padding="12"
            Margin="0,0,12,0">
      <Grid RowDefinitions="Auto,*,Auto">
        <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,8">
          <TextBlock Text="Chains (Read-Only)" FontWeight="Bold" FontSize="16" />
          <TextBlock Text="Loaded from configuration files" FontSize="11" Opacity="0.6" />
        </StackPanel>

        <ListBox Grid.Row="1"
                 ItemsSource="{Binding Chains}"
                 SelectedItem="{Binding SelectedChain, Mode=TwoWay}">
          <ListBox.ItemTemplate>
            <DataTemplate DataType="vm:ChainItemViewModel">
              <StackPanel Spacing="2" Margin="0,4">
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding TriggerSummary}" FontSize="11" Opacity="0.7" />
                <TextBlock Text="{Binding ScriptSlug, StringFormat='Script: {0}'}" FontSize="11" Opacity="0.7" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <Button Grid.Row="2"
                Content="Refresh Chains"
                Command="{Binding LoadChainsCommand}"
                HorizontalAlignment="Stretch"
                Margin="0,8,0,0" />
      </Grid>
    </Border>

    <!-- Right Pane: Chain Details, Manual Invocation & Runs -->
    <ScrollViewer Grid.Column="1">
      <StackPanel Spacing="16">
        <!-- Chain Details Card -->
        <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                CornerRadius="8"
                Padding="16">
          <StackPanel Spacing="8">
            <TextBlock Text="{Binding SelectedChain.Name, FallbackValue='Select a chain'}"
                       FontWeight="Bold"
                       FontSize="18" />

            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" Margin="0,8,0,0">
              <TextBlock Grid.Row="0" Grid.Column="0" Text="Chain ID:" FontWeight="SemiBold" Margin="0,0,16,4" />
              <SelectableTextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedChain.Id.Value}" />

              <TextBlock Grid.Row="1" Grid.Column="0" Text="Trigger:" FontWeight="SemiBold" Margin="0,0,16,4" />
              <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedChain.TriggerSummary}" />

              <TextBlock Grid.Row="2" Grid.Column="0" Text="Skill &amp; Script:" FontWeight="SemiBold" Margin="0,0,16,4" />
              <TextBlock Grid.Row="2" Grid.Column="1">
                <TextBlock.Text>
                  <MultiBinding StringFormat="{}{0} -> {1} ({2})">
                    <Binding Path="SelectedChain.SkillId" />
                    <Binding Path="SelectedChain.ScriptSlug" />
                    <Binding Path="SelectedChain.ScriptVersion" />
                  </MultiBinding>
                </TextBlock.Text>
              </TextBlock>

              <TextBlock Grid.Row="3" Grid.Column="0" Text="Delivery Channel:" FontWeight="SemiBold" Margin="0,0,16,4" />
              <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedChain.DeliveryChannel}" />

              <TextBlock Grid.Row="4" Grid.Column="0" Text="Requires HITL:" FontWeight="SemiBold" Margin="0,0,16,4" />
              <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedChain.RequiresHitl}" />
            </Grid>
          </StackPanel>
        </Border>

        <!-- Manual Invocation Card -->
        <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                CornerRadius="8"
                Padding="16">
          <StackPanel Spacing="8">
            <TextBlock Text="Manual Trigger (FunctionCall)" FontWeight="Bold" FontSize="14" />
            <TextBlock Text="Payload (JSON):" FontSize="11" Opacity="0.7" />
            <TextBox Text="{Binding FunctionCallPayload, Mode=TwoWay}"
                     AcceptsReturn="True"
                     Height="80"
                     FontFamily="Consolas,Menlo,monospace" />
            <Button Content="Trigger Chain Now"
                    Command="{Binding TriggerFunctionCallCommand}"
                    Classes="accent"
                    HorizontalAlignment="Left" />
          </StackPanel>
        </Border>

        <!-- Runs and Checkpoints -->
        <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                CornerRadius="8"
                Padding="16">
          <StackPanel Spacing="8">
            <TextBlock Text="Runs &amp; Checkpoints" FontWeight="Bold" FontSize="14" />

            <ItemsControl ItemsSource="{Binding Runs}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:ChainRunStateViewModel">
                  <Border Margin="0,4"
                          Padding="10"
                          CornerRadius="6"
                          Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
                    <StackPanel Spacing="4">
                      <Grid ColumnDefinitions="*,Auto,Auto">
                        <TextBlock Grid.Column="0" Text="{Binding RunId.Value, StringFormat='Run: {0}'}" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="{Binding Status}" Margin="8,0" FontWeight="Bold" />
                        <TextBlock Grid.Column="2" Text="{Binding FormattedDuration}" Opacity="0.7" />
                      </Grid>

                      <ItemsControl ItemsSource="{Binding Checkpoints}" Margin="8,4,0,0">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <TextBlock FontSize="11" Opacity="0.8">
                              <TextBlock.Text>
                                <MultiBinding StringFormat="[{0}] State: {1}">
                                  <Binding Path="Step" />
                                  <Binding Path="State" />
                                </MultiBinding>
                              </TextBlock.Text>
                            </TextBlock>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
