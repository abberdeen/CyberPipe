<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>CyberPipe.Service</AssemblyName>
    <RootNamespace>CyberPipe.Service</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\CyberPipe.Contracts\CyberPipe.Contracts.csproj" />
    <ProjectReference Include="..\CyberPipe.Logging\CyberPipe.Logging.csproj" />
    <ProjectReference Include="..\CyberPipe.Data\CyberPipe.Data.csproj" />
    <ProjectReference Include="..\CyberPipe.Router\CyberPipe.Router.csproj" />
    <ProjectReference Include="..\CyberPipe.Chains\CyberPipe.Chains.csproj" />
    <ProjectReference Include="..\CyberPipe.Skills\CyberPipe.Skills.csproj" />
    <ProjectReference Include="..\CyberPipe.Channels.Telegram\CyberPipe.Channels.Telegram.csproj" />
    <ProjectReference Include="..\CyberPipe.Security\CyberPipe.Security.csproj" />
    <ProjectReference Include="..\CyberPipe.Models\CyberPipe.Models.csproj" />
    <ProjectReference Include="..\CyberPipe.Setup\CyberPipe.Setup.csproj" />
    <ProjectReference Include="..\Execution\CyberPipe.Execution.Sandbox\CyberPipe.Execution.Sandbox.csproj" />
    <ProjectReference Include="..\Execution\CyberPipe.Brainstem.Supervisor\CyberPipe.Brainstem.Supervisor.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- Воркер не ProjectReference: его поднимает супервизор с аргументом pipe, не состав службы.
       Aspire собирает Service, этот шаг кладёт exe рядом с ним, откуда его ищет супервизор. -->
  <Target Name="CopyBrainstemWorker" AfterTargets="Build">
    <PropertyGroup>
      <_BrainstemProject>$(MSBuildThisFileDirectory)..\Execution\CyberPipe.Brainstem\CyberPipe.Brainstem.csproj</_BrainstemProject>
      <_BrainstemOut>$(MSBuildThisFileDirectory)..\Execution\CyberPipe.Brainstem\bin\$(Configuration)\$(TargetFramework)\</_BrainstemOut>
    </PropertyGroup>
    <MSBuild Projects="$(_BrainstemProject)" Targets="Build" Properties="Configuration=$(Configuration);OutputPath=$(_BrainstemOut)" />
    <ItemGroup>
      <_BrainstemFiles Include="$(_BrainstemOut)CyberPipe.Brainstem.exe" />
      <_BrainstemFiles Include="$(_BrainstemOut)CyberPipe.Brainstem.dll" />
      <_BrainstemFiles Include="$(_BrainstemOut)CyberPipe.Brainstem.deps.json" />
      <_BrainstemFiles Include="$(_BrainstemOut)CyberPipe.Brainstem.runtimeconfig.json" />
      <_BrainstemFiles Include="$(_BrainstemOut)CyberPipe.Brainstem.pdb" Condition="Exists('$(_BrainstemOut)CyberPipe.Brainstem.pdb')" />
    </ItemGroup>
    <Copy SourceFiles="@(_BrainstemFiles)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
  </Target>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.13" />
    <PackageReference Include="Quartz" Version="3.13.1" />
  </ItemGroup>
</Project>
