{
  "Database": {
    "Host": "localhost",
    "Port": 5432,
    "Database": "cyberpipe",
    "Username": "cyberpipe",
    "PasswordSecretKey": "database.password"
  },
  "Budget": {
    "DailyCapUsd": 0.50,
    "SoftTokenLimit": 4000,
    "HardTokenLimit": 12000,
    "MaxCloudTurns": 3,
    "MaxLocalTurns": 5
  },
  "Router": {
    "Tier0Enabled": true,
    "Tier1Enabled": true,
    "Tier2Enabled": true,
    "Tier3Enabled": true,
    "Tier1SimilarityThreshold": 0.80,
    "SemanticCacheEnabled": true,
    "SemanticCacheThreshold": 0.90,
    "SemanticCacheTtlMinutes": 1440,
    "SemanticCacheMaxEntries": 1000
  },
  "Models": {
    "EmbeddingModelId": "multilingual-e5-small",
    "LocalCatalogPath": "models/local-models.json",
    "CloudCatalogPath": "models/cloud-models.json"
  },
  "Sandbox": {
    "MemoryLimitMb": null,
    "TimeoutSeconds": 60
  },
  "Channels": {
    "TelegramEnabled": true,
    "TelegramBotTokenSecretKey": "telegram.botToken",
    "DesktopEnabled": true,
    "CliEnabled": true
  },
  "Owner": {
    "TelegramOwnerIds": []
  },
  "PerformanceTargets": {
    "Tier0TargetMilliseconds": 1,
    "StopTargetMilliseconds": 50
  }
}
