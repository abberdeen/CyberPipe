<Project Sdk="Microsoft.NET.Sdk">
  <Sdk Name="Aspire.AppHost.Sdk" Version="13.6.1" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>CyberPipe.AppHost</AssemblyName>
    <RootNamespace>CyberPipe.AppHost</RootNamespace>
    <!-- Аудит только прямых зависимостей: транзитивные уязвимости фреймворка
         оркестрации (напр. MessagePack через Aspire) не должны ронять dev-контур. -->
    <NuGetAuditMode>direct</NuGetAuditMode>
    <!-- Бандл Aspire CLI: оркестратор (DCP) и дашборд при `dotnet run` без установки CLI. -->
    <AspireUseCliBundle>true</AspireUseCliBundle>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.AppHost" Version="13.6.1" />
    <PackageReference Include="Aspire.Hosting" Version="13.6.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CyberPipe.Service\CyberPipe.Service.csproj" />
    <ProjectReference Include="..\CyberPipe.Desktop\CyberPipe.Desktop.csproj" />
  </ItemGroup>
</Project>
